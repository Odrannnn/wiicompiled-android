diff --git a/runtime/include/host_fault_access.h b/runtime/include/host_fault_access.h
new file mode 100644
index 0000000..952b8e3
--- /dev/null
+++ b/runtime/include/host_fault_access.h
@@ -0,0 +1,32 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace HostFault {
+enum class Access { Unknown, Read, Write };
+
+// Linux/Android arm64 signal frames store tagged records in sigcontext.__reserved.
+// ESR is required to distinguish a store from a read; an absent/malformed record
+// must not silently become a read and bypass the guest executable-write guard.
+inline Access DecodeAarch64Context(const void* records, size_t length) noexcept {
+    const auto* cursor = static_cast<const unsigned char*>(records);
+    if (!cursor) return Access::Unknown;
+    while (length >= 8) {
+        uint32_t magic, size;
+        std::memcpy(&magic, cursor, 4);
+        std::memcpy(&size, cursor + 4, 4);
+        if (!magic || size < 16 || size % 16 || size > length) return Access::Unknown;
+        if (magic == 0x45535201u) { // ESR_MAGIC, struct esr_context
+            uint64_t esr;
+            std::memcpy(&esr, cursor + 8, 8);
+            const auto exceptionClass = (esr >> 26) & 0x3fu;
+            if (exceptionClass != 0x24 && exceptionClass != 0x25) return Access::Unknown;
+            return (esr & (1u << 6)) ? Access::Write : Access::Read;
+        }
+        cursor += size;
+        length -= size;
+    }
+    return Access::Unknown;
+}
+}
