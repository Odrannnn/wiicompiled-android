diff --git a/runtime/third_party/libco/android.c b/runtime/third_party/libco/android.c
new file mode 100644
index 0000000..fa89893
--- /dev/null
+++ b/runtime/third_party/libco/android.c
@@ -0,0 +1,68 @@
+/* Android AArch64 backend, ISC license; see LICENSE.
+ * Register layout follows libco's aarch64.c by byuu and the higan team.
+ * Code is linked from android_swap.S, so no data pages become executable.
+ */
+#include "libco.h"
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct context {
+    uint64_t sp, lr;
+    uint64_t x19_x29[11];
+    uint64_t padding;
+    uint64_t d8_d15[8];
+    uint64_t fpcr, fpsr;
+    void (*entry)(void);
+};
+_Static_assert(offsetof(struct context, d8_d15) == 112, "assembly SIMD offset");
+_Static_assert(offsetof(struct context, fpcr) == 176, "assembly FP offset");
+_Static_assert(offsetof(struct context, entry) == 192, "assembly context size");
+
+static _Thread_local struct context primary;
+static _Thread_local struct context* active;
+extern void mkw_co_swap(struct context* next, struct context* previous);
+
+static void co_entry(void) {
+    active->entry();
+    /* Returning from a cothread is a caller error, as in upstream libco. */
+    abort();
+}
+
+cothread_t co_active(void) {
+    if (!active) active = &primary;
+    return active;
+}
+
+cothread_t co_derive(void* memory, unsigned int size, void (*entry)(void)) {
+    if (!memory || !entry || size < sizeof(struct context) + 1024 ||
+        ((uintptr_t)memory % _Alignof(struct context)) != 0) return NULL;
+    struct context* next = (struct context*)memory;
+    memset(next, 0, sizeof(*next));
+    next->sp = ((uintptr_t)memory + size) & ~(uintptr_t)15;
+    next->lr = (uintptr_t)co_entry;
+    next->entry = entry;
+    __asm__ volatile("mrs %0, fpcr" : "=r"(next->fpcr));
+    __asm__ volatile("mrs %0, fpsr" : "=r"(next->fpsr));
+    co_active();
+    return next;
+}
+
+cothread_t co_create(unsigned int size, void (*entry)(void)) {
+    void* memory = malloc(size);
+    cothread_t result = co_derive(memory, size, entry);
+    if (!result) free(memory);
+    return result;
+}
+
+void co_delete(cothread_t handle) { free(handle); }
+
+void co_switch(cothread_t handle) {
+    struct context* previous = co_active();
+    active = (struct context*)handle;
+    mkw_co_swap(active, previous);
+}
+
+/* Contains process-local entry pointers; do not advertise serialized portability. */
+int co_serializable(void) { return 0; }
diff --git a/runtime/third_party/libco/android_swap.S b/runtime/third_party/libco/android_swap.S
new file mode 100644
index 0000000..e20523f
--- /dev/null
+++ b/runtime/third_party/libco/android_swap.S
@@ -0,0 +1,44 @@
+/* ISC license; see LICENSE. Register layout derived from aarch64.c.
+ * x18 is Android's reserved platform register: leave it untouched.
+ * The stack is non-executable. Only ABI-preserved SIMD low halves are saved.
+ */
+.text
+.p2align 2
+.global mkw_co_swap
+.hidden mkw_co_swap
+.type mkw_co_swap, %function
+mkw_co_swap:
+    hint #34                       // BTI c on supporting CPUs; NOP otherwise
+    mov x16, sp
+    stp x16, x30, [x1]
+    stp x19, x20, [x1, #16]
+    stp x21, x22, [x1, #32]
+    stp x23, x24, [x1, #48]
+    stp x25, x26, [x1, #64]
+    stp x27, x28, [x1, #80]
+    str x29, [x1, #96]
+    stp d8, d9, [x1, #112]
+    stp d10, d11, [x1, #128]
+    stp d12, d13, [x1, #144]
+    stp d14, d15, [x1, #160]
+    mrs x16, fpcr
+    mrs x17, fpsr
+    stp x16, x17, [x1, #176]
+    ldp x16, x17, [x0, #176]
+    msr fpcr, x16
+    msr fpsr, x17
+    ldp x19, x20, [x0, #16]
+    ldp x21, x22, [x0, #32]
+    ldp x23, x24, [x0, #48]
+    ldp x25, x26, [x0, #64]
+    ldp x27, x28, [x0, #80]
+    ldr x29, [x0, #96]
+    ldp d8, d9, [x0, #112]
+    ldp d10, d11, [x0, #128]
+    ldp d12, d13, [x0, #144]
+    ldp d14, d15, [x0, #160]
+    ldp x16, x30, [x0]
+    mov sp, x16
+    ret
+.size mkw_co_swap, .-mkw_co_swap
+.section .note.GNU-stack,"",%progbits
