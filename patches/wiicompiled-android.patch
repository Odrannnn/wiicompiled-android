--- /dev/null
+++ b/runtime/src/android_entry.cpp
@@ -0,0 +1,29 @@
+#if defined(__ANDROID__)
+#include <unistd.h>
+#include <cstdlib>
+#include <cstdio>
+#include <filesystem>
+#include <string>
+#include "runtime_config.h"
+extern int main(int argc, char** argv);
+
+// SDLActivity initializes Android/JNI and invokes SDL_main on SDL's native thread.
+// This library is linked into a locally built APK; no downloaded executable is run.
+extern "C" __attribute__((visibility("default"))) int SDL_main(int argc, char** argv) {
+    if (sysconf(_SC_PAGESIZE) != 4096) {
+        std::fputs("Android runtime currently requires 4 KiB host pages.\n", stderr);
+        return 1;
+    }
+    const char* external = std::getenv("MKW_ANDROID_EXTERNAL_STORAGE");
+    if (!external || !*external) return 1;
+    if (const char* overlays = std::getenv("MKW_ANDROID_OVERLAY_ROOTS"); overlays && *overlays) {
+        RuntimeConfigFile::AppendOverlayRoots(RuntimeConfigFile::Mutable(), std::string(overlays));
+    }
+    const auto root = std::filesystem::path(external) / "game";
+    if (chdir(root.c_str()) != 0) {
+        std::fputs("Missing Android game directory; prepare the local disc data first.\n", stderr);
+        return 1;
+    }
+    return main(argc, argv);
+}
+#endif
diff --git a/runtime/src/android_vulkan_loader.cpp b/runtime/src/android_vulkan_loader.cpp
new file mode 100644
index 0000000..01c23c5
--- /dev/null
+++ b/runtime/src/android_vulkan_loader.cpp
@@ -0,0 +1,161 @@
+#if defined(__ANDROID__)
+
+#include <adrenotools/driver.h>
+#include <android/log.h>
+#include <dlfcn.h>
+#include <cstdlib>
+#include <fstream>
+#include <span>
+#include <string>
+#include <utility>
+
+// Dawn's packaged Android archive loads libvulkan through this small class.  Providing the
+// complete implementation in the application makes the archive leave its own DynamicLib.o
+// unextracted, which gives Android builds one controlled hook without forking the rest of Dawn.
+// The class layout and signatures match Dawn commit 13abc3bc8ea2d3c2050f9e77a12d012108ceee24.
+namespace dawn {
+class DynamicLib {
+  public:
+    DynamicLib() = default;
+    ~DynamicLib();
+    DynamicLib(const DynamicLib&) = delete;
+    DynamicLib& operator=(const DynamicLib&) = delete;
+    DynamicLib(DynamicLib&& other);
+    DynamicLib& operator=(DynamicLib&& other);
+    bool Valid() const;
+    bool Open(const std::string& filename, std::string* error = nullptr);
+    bool Open(const std::string& filename, std::span<const std::string> searchPaths,
+              std::string* error = nullptr);
+    bool OpenLoaded(const std::string& filename, std::string* error = nullptr);
+    void Close();
+    void* GetProc(const std::string& procName, std::string* error = nullptr) const;
+
+  private:
+    void* mHandle = nullptr;
+    bool mNeedsClose = false;
+};
+
+namespace {
+constexpr const char* kTag = "WiiCompiledGpuDriver";
+
+const char* Env(const char* name) {
+    const char* value = std::getenv(name);
+    return value && *value ? value : nullptr;
+}
+
+void WriteStatus(const std::string& text) {
+    __android_log_print(ANDROID_LOG_INFO, kTag, "%s", text.c_str());
+    const char* files = Env("MKW_ANDROID_FILES_DIR");
+    if (!files) return;
+    std::ofstream output(std::string(files) + "/gpu-driver-runtime-status.txt",
+                         std::ios::binary | std::ios::trunc);
+    output << text << '\n';
+}
+
+void* OpenCustomVulkan(std::string* error) {
+    const char* driverDir = Env("MKW_VULKAN_DRIVER_DIR");
+    const char* soname = Env("MKW_VULKAN_DRIVER_SONAME");
+    if (!driverDir || !soname) return nullptr;
+    const char* hookDir = Env("MKW_ANDROID_NATIVE_LIBRARY_DIR");
+    const char* tmpDir = Env("MKW_VULKAN_DRIVER_TMP");
+    if (!hookDir || !tmpDir) {
+        if (error) *error = "custom driver environment is incomplete";
+        return nullptr;
+    }
+    std::string normalizedDir(driverDir);
+    if (normalizedDir.back() != '/') normalizedDir.push_back('/');
+    dlerror();
+    void* handle = adrenotools_open_libvulkan(RTLD_NOW | RTLD_LOCAL,
+        ADRENOTOOLS_DRIVER_CUSTOM, tmpDir, hookDir, normalizedDir.c_str(), soname, nullptr, nullptr);
+    if (!handle && error) {
+        const char* detail = dlerror();
+        *error = detail ? detail : "adrenotools_open_libvulkan returned null";
+    }
+    return handle;
+}
+}  // namespace
+
+DynamicLib::~DynamicLib() { Close(); }
+DynamicLib::DynamicLib(DynamicLib&& other) {
+    std::swap(mHandle, other.mHandle);
+    mNeedsClose = other.mNeedsClose;
+}
+DynamicLib& DynamicLib::operator=(DynamicLib&& other) {
+    std::swap(mHandle, other.mHandle);
+    mNeedsClose = other.mNeedsClose;
+    return *this;
+}
+bool DynamicLib::Valid() const { return mHandle != nullptr; }
+
+bool DynamicLib::Open(const std::string& filename, std::string* error) {
+    if (mHandle) {
+        if (error) *error = "DynamicLib is already open";
+        return false;
+    }
+    const bool selectedVulkan = filename == "libvulkan.so" && Env("MKW_VULKAN_DRIVER_DIR");
+    std::string customError;
+    if (selectedVulkan) {
+        mHandle = OpenCustomVulkan(&customError);
+        if (mHandle) {
+            const char* label = Env("MKW_VULKAN_DRIVER_LABEL");
+            WriteStatus(std::string("Custom driver loaded: ") +
+                        (label ? label : Env("MKW_VULKAN_DRIVER_SONAME")));
+        }
+    }
+    if (!mHandle) {
+        dlerror();
+        mHandle = dlopen(filename.c_str(), RTLD_NOW);
+        if (mHandle && filename == "libvulkan.so") {
+            WriteStatus(selectedVulkan
+                ? "Custom driver failed; using system Vulkan driver. " + customError
+                : "System Vulkan driver loaded.");
+        }
+    }
+    if (!mHandle && error) {
+        const char* detail = dlerror();
+        *error = detail ? detail : "dlopen failed";
+    }
+    mNeedsClose = mHandle != nullptr;
+    return mNeedsClose;
+}
+
+bool DynamicLib::OpenLoaded(const std::string& filename, std::string* error) {
+    if (mHandle) {
+        if (error) *error = "DynamicLib is already open";
+        return false;
+    }
+    dlerror();
+    mHandle = dlopen(filename.c_str(), RTLD_NOW | RTLD_NOLOAD);
+    if (!mHandle && error) {
+        const char* detail = dlerror();
+        *error = detail ? detail : "library is not loaded";
+    }
+    mNeedsClose = false;
+    return mHandle != nullptr;
+}
+
+bool DynamicLib::Open(const std::string& filename, std::span<const std::string> searchPaths,
+                      std::string* error) {
+    for (const std::string& path : searchPaths) if (Open(path + filename, error)) return true;
+    return false;
+}
+
+void DynamicLib::Close() {
+    if (!mHandle) return;
+    if (mNeedsClose) dlclose(mHandle);
+    mNeedsClose = false;
+    mHandle = nullptr;
+}
+
+void* DynamicLib::GetProc(const std::string& procName, std::string* error) const {
+    dlerror();
+    void* proc = dlsym(mHandle, procName.c_str());
+    if (!proc && error) {
+        const char* detail = dlerror();
+        *error = detail ? detail : "dlsym failed";
+    }
+    return proc;
+}
+}  // namespace dawn
+
+#endif
