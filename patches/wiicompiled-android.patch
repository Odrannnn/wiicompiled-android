+
+void RiivoApplyLowMemoryPatches(const RiivolutionContract::Patch& patch, RiivoState& state) {
+    constexpr uint32_t kFirstDataAddress = 0x80001000u;
+    constexpr uint32_t kEndDataAddress = 0x80006000u;
+    for (const auto& memory : patch.memoryPatches) {
+        // Loader uploads and original-guarded branches are executable patches already
+        // represented by the selected translated product. Only direct low-memory data
+        // writes belong here.
+        if (!memory.valuefile.empty() || !memory.original.empty() || memory.value.empty() ||
+            (memory.value.size() & 1u) != 0u || memory.offset < kFirstDataAddress) {
+            continue;
+        }
+        const size_t byteCount = memory.value.size() / 2u;
+        const uint64_t end = static_cast<uint64_t>(memory.offset) + byteCount;
+        if (end > kEndDataAddress || !Memory::Contains(memory.offset, byteCount)) {
+            continue;
+        }
+        std::vector<uint8_t> bytes;
+        bytes.reserve(byteCount);
+        bool valid = true;
+        for (size_t index = 0; index < memory.value.size(); index += 2u) {
+            const int high = RiivoHexNibble(memory.value[index]);
+            const int low = RiivoHexNibble(memory.value[index + 1u]);
+            if (high < 0 || low < 0) { valid = false; break; }
+            bytes.push_back(static_cast<uint8_t>((high << 4) | low));
+        }
+        if (!valid) continue;
+        for (size_t index = 0; index < bytes.size(); ++index) {
+            Memory::Write8(memory.offset + static_cast<uint32_t>(index), bytes[index]);
+        }
+        state.lowMemoryBytesWritten += static_cast<uint32_t>(bytes.size());
+        RT_LOG(RT_TAG_RIIVOLUTION) << "low-memory data patch: 0x" << std::hex
+                  << std::uppercase << memory.offset << " (" << std::dec << bytes.size()
+                  << " byte(s))" << std::nouppercase << std::endl;
