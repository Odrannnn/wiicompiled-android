+static void apply_gyro_trick(aurora::input::GameController& controller, PADStatus& status) {
+  if (controller.m_gyroSensor == SDL_SENSOR_INVALID) {
+    return;
+  }
+
+  const bool requested = g_gyroTricksEnabled.load(std::memory_order_relaxed);
+  if (requested != controller.m_gyroSensorEnabled) {
+    if (SDL_SetGamepadSensorEnabled(controller.m_controller, controller.m_gyroSensor, requested)) {
+      controller.m_gyroSensorEnabled = requested;
+    }
+    controller.m_gyroTrickPulseUntil = 0;
+    controller.m_gyroTrickCooldownUntil = 0;
+  }
+  if (!controller.m_gyroSensorEnabled) {
+    return;
+  }
+
+  const Uint64 now = SDL_GetTicks();
+  float gyro[3]{};
+  if (SDL_GetGamepadSensorData(controller.m_controller, controller.m_gyroSensor, gyro, 3)) {
+    const float magnitude = std::sqrt(gyro[0] * gyro[0] + gyro[1] * gyro[1] + gyro[2] * gyro[2]);
+    if (magnitude >= g_gyroTrickThreshold.load(std::memory_order_relaxed) &&
+        now >= controller.m_gyroTrickCooldownUntil) {
+      controller.m_gyroTrickPulseUntil = now + kGyroTrickPulseMs;
+      controller.m_gyroTrickCooldownUntil = now + kGyroTrickCooldownMs;
+    }
+  }
+  if (now < controller.m_gyroTrickPulseUntil) {
+    status.button |= PAD_BUTTON_UP;
+  }
+}
