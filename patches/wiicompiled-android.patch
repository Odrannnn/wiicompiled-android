+// A newly formatted Wii Mii database consists of a 0x1f1e0-byte header followed
+// by 10,000 empty 74-byte hidden-Mii records. The final format write is rounded
+// to 32 bytes, leaving 12 harmless trailing bytes in the file. These constants
+// and the checksum routine follow the open-source RVLFaceLib implementation.
+// Generating this empty database avoids requiring or copying console-owned Mii
+// data while giving games the same state as a Wii whose Mii database was reset.
+bool SeedFaceLibDatabase(const std::filesystem::path& hostPath) {
+    constexpr size_t kHeaderSize = 0x1f1e0;
+    constexpr size_t kDatabaseSize = 0xd3c8c;
+    constexpr size_t kIsolationOffset = 0x1cec;
+    constexpr size_t kHiddenHeaderOffset = 0x1d00;
+    constexpr size_t kFormatTableOffset = kHiddenHeaderOffset + 8;
+    constexpr size_t kFormatTableSize = 12;
+    constexpr size_t kFormatTableCount = 10000;
+    constexpr size_t kCrcOffset = kHeaderSize - 2;
+
+    std::vector<uint8_t> database(kDatabaseSize, 0);
+    auto writeBe16 = [&](size_t offset, uint16_t value) {
+        database[offset] = static_cast<uint8_t>(value >> 8);
+        database[offset + 1] = static_cast<uint8_t>(value);
+    };
+    auto writeBe32 = [&](size_t offset, uint32_t value) {
+        database[offset] = static_cast<uint8_t>(value >> 24);
+        database[offset + 1] = static_cast<uint8_t>(value >> 16);
+        database[offset + 2] = static_cast<uint8_t>(value >> 8);
+        database[offset + 3] = static_cast<uint8_t>(value);
+    };
+
+    writeBe32(0, 0x524e4f44);                    // RNOD
+    writeBe32(kIsolationOffset, 0x80000000);     // isolation = TRUE on PPC
+    writeBe32(kHiddenHeaderOffset, 0x524e4844);  // RNHD
+    writeBe16(kHiddenHeaderOffset + 4, 0xffff);  // empty list head
+    writeBe16(kHiddenHeaderOffset + 6, 0xffff);  // empty list tail
+    for (size_t i = 0; i < kFormatTableCount; ++i) {
+        const size_t entry = kFormatTableOffset + i * kFormatTableSize;
+        // PPC bitfields put the one-bit sex/padding fields first, leaving the
+        // signed 15-bit next/previous links as 0x7fff for -1.
+        writeBe16(entry + 8, 0x7fff);
+        writeBe16(entry + 10, 0x7fff);
+    }
+
+    uint16_t crc = 0;
+    for (size_t offset = 0; offset < kHeaderSize; ++offset) {
+        uint8_t value = database[offset];
+        for (int bit = 0; bit < 8; ++bit) {
+            crc = static_cast<uint16_t>((crc << 1) ^ ((crc & 0x8000) ? 0x1021 : 0));
+            if (value & 0x80) {
+                crc ^= 1;
+            }
+            value <<= 1;
+        }
+    }
+    writeBe16(kCrcOffset, crc);
+
+    CreateParentDirectories(hostPath);
+    std::ofstream out(hostPath, std::ios::binary);
+    if (!out) {
+        LogNandError("FaceLibSeed", "Failed to create %s", HostPathText(hostPath).c_str());
+        return false;
+    }
+    out.write(reinterpret_cast<const char*>(database.data()), static_cast<std::streamsize>(database.size()));
+    if (!out) {
+        LogNandError("FaceLibSeed", "Failed to write %s", HostPathText(hostPath).c_str());
+        return false;
+    }
+
+    return true;
+}
