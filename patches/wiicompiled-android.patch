new file mode 100644
index 0000000..2499abd
--- /dev/null
+++ b/runtime/src/android_entry.cpp
@@ -0,0 +1,29 @@
+#if defined(__ANDROID__)
+#include <unistd.h>
+#include <cstdlib>
+#include <cstdio>
+#include <filesystem>
+#include <string>
+#include "runtime_config.h"
+extern int main(int argc, char** argv);
+
+// SDLActivity initializes Android/JNI and invokes SDL_main on SDL's native thread.
+// This library is linked into a locally built APK; no downloaded executable is run.
+extern "C" __attribute__((visibility("default"))) int SDL_main(int argc, char** argv) {
+    if (sysconf(_SC_PAGESIZE) != 4096) {
+        std::fputs("Android runtime currently requires 4 KiB host pages.\n", stderr);
+        return 1;
+    }
+    const char* external = std::getenv("MKW_ANDROID_EXTERNAL_STORAGE");
+    if (!external || !*external) return 1;
+    if (const char* overlays = std::getenv("MKW_ANDROID_OVERLAY_ROOTS"); overlays && *overlays) {
+        RuntimeConfigFile::AppendOverlayRoots(RuntimeConfigFile::Mutable(), std::string(overlays));
+    }
+    const auto root = std::filesystem::path(external) / "game";
+    if (chdir(root.c_str()) != 0) {
+        std::fputs("Missing Android game directory; prepare the local disc data first.\n", stderr);
+        return 1;
+    }
+    return main(argc, argv);
+}
+#endif
