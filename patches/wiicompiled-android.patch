+/* Android AArch64 backend, ISC license; see LICENSE.
+ * Register layout follows libco's aarch64.c by byuu and the higan team.
+ * Code is linked from android_swap.S, so no data pages become executable.
+ */
+#include "libco.h"
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct context {
+    uint64_t sp, lr;
+    uint64_t x19_x29[11];
+    uint64_t padding;
+    uint64_t d8_d15[8];
+    uint64_t fpcr, fpsr;
+    void (*entry)(void);
+};
+_Static_assert(offsetof(struct context, d8_d15) == 112, "assembly SIMD offset");
+_Static_assert(offsetof(struct context, fpcr) == 176, "assembly FP offset");
+_Static_assert(offsetof(struct context, entry) == 192, "assembly context size");
+
+static _Thread_local struct context primary;
+static _Thread_local struct context* active;
+extern void mkw_co_swap(struct context* next, struct context* previous);
+
+static void co_entry(void) {
+    active->entry();
+    /* Returning from a cothread is a caller error, as in upstream libco. */
+    abort();
+}
+
+cothread_t co_active(void) {
+    if (!active) active = &primary;
+    return active;
+}
+
+cothread_t co_derive(void* memory, unsigned int size, void (*entry)(void)) {
+    if (!memory || !entry || size < sizeof(struct context) + 1024 ||
+        ((uintptr_t)memory % _Alignof(struct context)) != 0) return NULL;
+    struct context* next = (struct context*)memory;
+    memset(next, 0, sizeof(*next));
+    next->sp = ((uintptr_t)memory + size) & ~(uintptr_t)15;
+    next->lr = (uintptr_t)co_entry;
+    next->entry = entry;
+    __asm__ volatile("mrs %0, fpcr" : "=r"(next->fpcr));
+    __asm__ volatile("mrs %0, fpsr" : "=r"(next->fpsr));
+    co_active();
+    return next;
+}
+
+cothread_t co_create(unsigned int size, void (*entry)(void)) {
+    void* memory = malloc(size);
+    cothread_t result = co_derive(memory, size, entry);
+    if (!result) free(memory);
+    return result;
+}
+
+void co_delete(cothread_t handle) { free(handle); }
+
+void co_switch(cothread_t handle) {
+    struct context* previous = co_active();
+    active = (struct context*)handle;
+    mkw_co_swap(active, previous);
+}
+
+/* Contains process-local entry pointers; do not advertise serialized portability. */
+int co_serializable(void) { return 0; }
